[node name="columnNewspaper3" type="Label" parent="Node2D" unique_id=1236398203]
offset_left = -939.0
offset_top = 459.0
offset_right = 933.405
offset_bottom = 544.0
text = "El museo de khachkars, que albergaba una colección significativa de estas piedras talladas, fue cerrado de forma repentina hace algunos años. Desde entonces, no se ha emitido un informe oficial concluyente. Visitantes recientes describen el acceso principal como parcialmente deteriorado. Una de las piezas cercanas a la entrada presenta daños visibles, aunque no existen registros públicos que expliquen cuándo ocurrieron. Documentos internos apuntan a actividad inusual en los días previos al cierre, incluyendo accesos fuera de horario y el uso de áreas no abiertas al público. Inventarios incompletos muestran discrepancias: ciertas piezas no figuran como trasladadas, pero tampoco fueron encontradas en sus ubicaciones habituales. El paradero de parte del personal sigue sin esclarecerse. Los últimos reportes indican que varios permanecieron en el recinto más tiempo del previsto."
label_settings = SubResource("LabelSettings_c824c")
autowrap_mode = 2

